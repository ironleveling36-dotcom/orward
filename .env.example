# Get these from https://my.telegram.org -> API Development Tools
API_ID=1234567
API_HASH=your_api_hash_here

# Your phone number in international format, e.g. +919876543210
PHONE_NUMBER=+910000000000

# Generated by running generate_session.py locally (see README). Paste the
# long string it prints here. NEVER share this string with anyone — it is
# equivalent to your Telegram login.
SESSION_STRING=

# Optional: restrict control panel to your own account only (recommended).
# Leave blank to auto-detect (safe default, since it's your own account logging in).
OWNER_ID=

# Default delay in seconds between each forwarded message (can be changed
# later from the inline button menu too)
DEFAULT_DELAY=5
